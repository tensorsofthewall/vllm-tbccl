             f"pipeline_send expects a (1, n_tokens, hidden) hidden state, "
             f"got shape {tuple(h.shape)}"
         )
-    return mx.distributed.send(h[0], pp.rank + 1, group=pp.group)
+    return pp.transport.send(h[0], pp.rank + 1)
 
 
